# Inventaire généré automatiquement par Terraform — ne pas modifier manuellement

[bastion]
${bastion_ip} ansible_user=ec2-user ansible_ssh_private_key_file=${ssh_key_path}

[web]
${web_ip} ansible_user=ec2-user ansible_ssh_private_key_file=${ssh_key_path}

[ftp]
${ftp_ip} ansible_user=ec2-user ansible_ssh_private_key_file=${ssh_key_path}

[private:children]
web
ftp

# Les machines privées sont joignables uniquement via le bastion (ProxyJump)
[private:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o ProxyJump=ec2-user@${bastion_ip}'
ansible_ssh_private_key_file=${ssh_key_path}